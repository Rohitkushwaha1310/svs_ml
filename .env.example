# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# --- Supabase ---------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- ML API location ------------------------------------------------
# Where the webhook sends prediction requests. Point this at your own
# running instance while developing locally, or at a separately deployed
# ML API once you split the services.
ML_MODEL_URL=http://127.0.0.1:8000/predict

# --- Webhook security ---------------------------------------------------
# Shared secret checked against the X-Webhook-Secret header on
# POST /webhook/activity. Configure the same value as a custom header in
# your Supabase Database Webhook settings. Leave blank only for local
# testing — never leave it blank in production.
WEBHOOK_SECRET=
